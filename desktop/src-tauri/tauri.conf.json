{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LM-WebUI",
  "version": "0.8.18",
  "identifier": "com.lmwebui.desktop",
  "build": {
    "beforeDevCommand": "npm --prefix ../web run dev",
    "frontendDist": "../loader",
    "devUrl": "http://localhost:5177"
  },
  "app": {
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
