{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LM-WebUI",
  "version": "0.8.21",
  "identifier": "com.lmwebui.desktop",
  "build": {
    "beforeDevCommand": "npm --prefix ../web run dev",
    "frontendDist": "../loader",
    "devUrl": "http://localhost:5177"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self'; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    }
  }
}
