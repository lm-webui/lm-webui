{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LM-WebUI",
  "version": "0.8.3",
  "identifier": "com.lmwebui.desktop",
  "build": {
    "beforeDevCommand": "npm run build:web",
    "beforeBuildCommand": "npm run build:web && npm run build:sidecar",
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5177"
  },
  "app": {
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "web-dist",
      "binaries/lm-webui-backend"
    ]
  }
}
