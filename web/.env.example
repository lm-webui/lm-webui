# Web frontend environment. Copy to .env.development for local development:
VITE_BACKEND_URL=http://localhost:7070
VITE_WS_URL=ws://localhost:7070/ws/chat

# The packaged build does not use this file, and does not need to.
#
# The release workflow runs `npm run build` in an environment where no .env.development
# exists, so both values compile to "" — and an empty VITE_BACKEND_URL resolves to
# window.location.origin (src/utils/api.ts). That is correct: in the shipped app the
# backend serves web/dist itself, so the API is same-origin. Setting localhost here
# would point a release build at whatever machine built it.
#
# The two values above are for `npm run dev` only, where Vite serves the frontend on
# port 5177 and needs to be told where the backend actually lives.
