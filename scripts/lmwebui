#!/bin/bash
# lm-webui — CLI for managing LM-WebUI service
# Installed at ~/.lmwebui/lmwebui, symlinked to /usr/local/bin/lm-webui

set -e

LMWEBUI_HOME="${LMWEBUI_HOME:-$HOME/.lmwebui}"

# The service definition (systemd unit / launchd plist) pins the bind address; config.yaml's
# server.host/port are not read by anything, so this is the one place the port is decided.
PORT=7070
LOCAL_URL="http://localhost:$PORT"
API="$LOCAL_URL"

# ── Dashboard address ────────────────────────────────────────────────────
# The service binds 0.0.0.0:7070, so on a headless or LAN box the address you actually open is
# this machine's own IPv4. python3 is already required by this script, so it does the detection
# (a UDP connect picks the default route's interface and sends nothing).
lan_ip() {
  python3 - <<'PY' 2>/dev/null || true
import socket
s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
try:
    s.connect(("8.8.8.8", 80))
    print(s.getsockname()[0])
except OSError:
    print("")
finally:
    s.close()
PY
}

show_url() {
  local ip="$(lan_ip)"
  if [ -n "$ip" ] && [ "$ip" != "127.0.0.1" ]; then
    echo "Open: http://$ip:$PORT  (this machine: $LOCAL_URL)"
  else
    echo "Open: $LOCAL_URL"
  fi
}

# ── Diagnostics ──────────────────────────────────────────────────────────
# Only printed when the service is not answering, so every line here is a reason it might not be.
diagnose() {
  echo "   Diagnosing:"
  if pgrep -f "uvicorn app.main:app" >/dev/null 2>&1; then
    echo "   • an uvicorn process is running (still starting up, or stuck)"
  else
    echo "   • no uvicorn process — the service is not running"
  fi
  if python3 -c "import socket,sys; s=socket.socket(); sys.exit(0 if s.connect_ex(('127.0.0.1',$PORT))==0 else 1)" 2>/dev/null; then
    echo "   • port $PORT is in use, but not by a healthy LM-WebUI"
    if command -v lsof >/dev/null 2>&1; then
      lsof -nP -iTCP:$PORT -sTCP:LISTEN 2>/dev/null | tail -n +2 | awk '{print "     held by PID " $2 " (" $1 ")"}'
    fi
  else
    echo "   • port $PORT is free"
  fi
  if [ -x "$LMWEBUI_HOME/.venv/bin/uvicorn" ]; then
    echo "   • $LMWEBUI_HOME/.venv/bin/uvicorn present"
  else
    echo "   • $LMWEBUI_HOME/.venv/bin/uvicorn is missing — re-run the installer"
  fi
  if [ ! -f "$LMWEBUI_HOME/config.yaml" ]; then
    echo "   • $LMWEBUI_HOME/config.yaml is missing"
  elif [ ! -x "$LMWEBUI_HOME/.venv/bin/python" ]; then
    echo "   • config.yaml not checked (no venv python to parse it with)"
  elif "$LMWEBUI_HOME/.venv/bin/python" -c 'import sys,yaml; yaml.safe_load(open(sys.argv[1]))' "$LMWEBUI_HOME/config.yaml" 2>/dev/null; then
    echo "   • config.yaml parses"
  else
    echo "   • config.yaml does not parse — see logs below"
  fi
  local log="$LMWEBUI_HOME/logs/stderr.log"
  [ -s "$log" ] || log="$LMWEBUI_HOME/logs/stdout.log"
  if [ -s "$log" ]; then
    echo "   Last lines of $(basename "$log"):"
    tail -n 15 "$log" | sed 's/^/     /'
  fi
}

# Warn-only: /api/auth/status reports whether any user exists yet. There is no setup token, and
# the first registrant becomes admin, so an operator on an open LAN needs to know.
first_run_notice() {
  local has
  has="$(curl -sf --max-time 5 "$API/api/auth/status" 2>/dev/null \
    | python3 -c 'import sys,json; print(json.load(sys.stdin).get("hasUser"))' 2>/dev/null)" || true
  if [ "$has" = "False" ]; then
    echo "⚠️  No account yet — the first user to register at $LOCAL_URL becomes admin."
    echo "    Register now if this machine is reachable from an untrusted network."
  fi
  return 0
}

# ── Runtime ensure helpers (mirror install.sh; idempotent) ───────────────
ensure_llama_server() {
  # llama-server is the multimodal (Vision) engine; ensure it's available.
  if command -v llama-server &>/dev/null; then
    echo "   llama-server: available"
    return
  fi
  echo "   Installing llama-server..."
  local bin_dir="$LMWEBUI_HOME/bin"
  mkdir -p "$bin_dir"
  if [ "$(uname)" = "Darwin" ] && command -v brew &>/dev/null; then
    brew install llama.cpp 2>/dev/null && { echo "   llama-server installed via brew"; export PATH="$bin_dir:$PATH"; return; }
  fi
  local os="$([ "$(uname)" = "Darwin" ] && echo macos || echo ubuntu)"
  local arch="$([ "$(uname -m)" = "arm64" ] || [ "$(uname -m)" = "aarch64" ] && echo arm64 || echo x64)"
  local tag="$(curl -fsSL https://api.github.com/repos/ggml-org/llama.cpp/releases/latest 2>/dev/null | grep -m1 '"tag_name"' | sed 's/.*"\([^"]*\)".*/\1/')"
  local url="https://github.com/ggml-org/llama.cpp/releases/latest/download/llama-$tag-bin-$os-$arch.tar.gz"
  if [ -n "$tag" ] && curl -fsSL -o /tmp/llama-bin.tar.gz "$url" 2>/dev/null && tar -xzf /tmp/llama-bin.tar.gz -C "$bin_dir" 2>/dev/null; then
    local src="$(find "$bin_dir" -type f -name llama-server | head -1)"
    if [ -n "$src" ]; then
      local src_dir="$(dirname "$src")"
      cp "$src_dir/"* "$bin_dir/" 2>/dev/null
      rm -rf "$src_dir"
      chmod +x "$bin_dir/llama-server"
      export PATH="$bin_dir:$PATH"
      { echo ""; echo '# llama.cpp (LM-WebUI)'; echo "export PATH=\"$bin_dir:\$PATH\""; } >> "$HOME/.bashrc" 2>/dev/null
      [ -f "$HOME/.zshrc" ] && echo "export PATH=\"$bin_dir:\$PATH\"" >> "$HOME/.zshrc"
      command -v llama-server &>/dev/null && echo "   llama-server installed to $bin_dir" && return
    fi
  fi
  echo "   ⚠️ Could not install llama-server automatically — Vision needs it. Install llama.cpp from releases."
}

check_gguf_runtime() {
  echo "   Checking llama.cpp runtime..."
  local missing=0
  for bin in llama-server llama-cli llama-bench llama-quantize; do
    if command -v "$bin" &>/dev/null; then
      echo "     ✓ $bin"
    else
      echo "     ✗ $bin"
      missing=1
    fi
  done
  if command -v llama-server &>/dev/null; then
    echo "   llama-server version: $(llama-server --version 2>&1 | head -1)"
  fi
  [ "$missing" -eq 0 ] && echo "   llama.cpp runtime OK — vision ready."
}

ensure_mlx() {
  # Apple-only: ensure MLX packages are present (no-op on Linux).
  if [ "$(uname)" = "Darwin" ]; then
    if [ -f "$LMWEBUI_HOME/.venv/bin/python" ] && ! "$LMWEBUI_HOME/.venv/bin/python" -c "import mlx" 2>/dev/null; then
      echo "   Installing MLX (Apple Silicon)..."
      # `python -m pip` is not enough: the venv is built with uv and ships no pip, so this
      # silently failed on every update (the || swallowed "No module named pip"). Missing
      # mlx is a no-op here, which is why it went unnoticed. Same pattern as install.sh.
      if command -v uv &>/dev/null; then
        uv pip install mlx mlx-lm mlx-optiq --python "$LMWEBUI_HOME/.venv/bin/python" --quiet 2>&1 || echo "   ⚠️ MLX install failed (Apple Silicon only)."
      else
        "$LMWEBUI_HOME/.venv/bin/python" -m pip install mlx mlx-lm mlx-optiq --quiet 2>&1 || echo "   ⚠️ MLX install failed (Apple Silicon only)."
      fi
    else
      echo "   MLX: present"
    fi
  fi
}

LINUX_SERVICE_SCOPE="system"

detect_linux_service_scope() {
  [ "$(uname)" = "Linux" ] || return 0
  if sudo -n systemctl cat lmwebui >/dev/null 2>&1; then
    LINUX_SERVICE_SCOPE="system"
  elif systemctl --user cat lmwebui >/dev/null 2>&1; then
    LINUX_SERVICE_SCOPE="user"
  else
    LINUX_SERVICE_SCOPE="system"
  fi
}

linux_service() {
  detect_linux_service_scope
  if [ "$LINUX_SERVICE_SCOPE" = "user" ]; then
    systemctl --user "$@"
  else
    sudo systemctl "$@"
  fi
}

reinstall_service() {
  # Recreate the service unit so PATH/ExecStart changes take effect (idempotent).
  case "$(uname)" in
    Linux)
      detect_linux_service_scope
      local unit_dir="/etc/systemd/system"
      local service_user_line="User=$USER"
      if [ "$LINUX_SERVICE_SCOPE" = "user" ]; then
        unit_dir="$HOME/.config/systemd/user"
        mkdir -p "$unit_dir"
        service_user_line=""
      fi
      cat > /tmp/lmwebui.service << SERVICEEOF
[Unit]
Description=LM-WebUI
After=network.target
[Service]
Type=simple
$service_user_line
WorkingDirectory=$LMWEBUI_HOME
Environment=LMWEBUI_HOME=$LMWEBUI_HOME
Environment=LMWEBUI_BASE_DIR=$LMWEBUI_HOME
Environment=PATH=$LMWEBUI_HOME/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=$LMWEBUI_HOME/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port $PORT
Restart=on-failure
[Install]
WantedBy=multi-user.target
SERVICEEOF
      if command -v systemctl &>/dev/null; then
        if [ "$LINUX_SERVICE_SCOPE" = "user" ]; then
          mv /tmp/lmwebui.service "$unit_dir/lmwebui.service"
          systemctl --user daemon-reload
          systemctl --user enable lmwebui
        else
          sudo mv /tmp/lmwebui.service "$unit_dir/lmwebui.service"
          sudo systemctl daemon-reload
          sudo systemctl enable lmwebui
        fi
        echo "   systemd unit refreshed ($LINUX_SERVICE_SCOPE)."
      else
        echo "❌ systemctl is unavailable" >&2
        return 1
      fi ;;
    Darwin)
      PLIST_PATH="$HOME/Library/LaunchAgents/com.lmwebui.server.plist"
      # launchd silently fails to start the job if the log paths don't exist.
      mkdir -p "$HOME/Library/LaunchAgents" "$LMWEBUI_HOME/logs"
      cat > "$PLIST_PATH" << PLISTEOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>com.lmwebui.server</string>
<key>ProgramArguments</key><array><string>$LMWEBUI_HOME/.venv/bin/uvicorn</string><string>app.main:app</string><string>--host</string><string>0.0.0.0</string><string>--port</string><string>$PORT</string></array>
<key>WorkingDirectory</key><string>$LMWEBUI_HOME</string>
<key>EnvironmentVariables</key><dict><key>LMWEBUI_HOME</key><string>$LMWEBUI_HOME</string><key>LMWEBUI_BASE_DIR</key><string>$LMWEBUI_HOME</string><key>PATH</key><string>$LMWEBUI_HOME/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string></dict>
<key>RunAtLoad</key><true/><key>KeepAlive</key><true/>
<key>StandardOutPath</key><string>$LMWEBUI_HOME/logs/stdout.log</string>
<key>StandardErrorPath</key><string>$LMWEBUI_HOME/logs/stderr.log</string>
</dict></plist>
PLISTEOF
      echo "   launchd plist refreshed."
      ;;
  esac
}

# ── Internal: installer plumbing ─────────────────────────────────────────
# __install_tree is called by install.sh (`lm-webui __install-tree <release-tree>`) and by `update`
# below. It is the single implementation of "replace the code, keep the user's data" — the second
# copy that used to live in install.sh is what let a release tarball's config.yaml clobber a live
# one on update, while install.sh's copy guarded against exactly that.
#
# Nothing here may use $0 or `source`: reached through the /usr/local/bin/lm-webui symlink, $0 is
# the symlink, not this file.
__install_tree() {
  local src="${1:?__install-tree needs a release tree}"
  [ -f "$src/app/main.py" ] || { echo "❌ $src is not a release tree (no app/main.py)"; exit 1; }

  # 1. Stage the shipped config, then DELETE it from $src. This is the guard: once config.yaml is
  #    out of the source tree, the bulk copy below cannot overwrite a live one.
  local tpl="$LMWEBUI_HOME/config.yaml.template"
  mkdir -p "$LMWEBUI_HOME"
  if [ -f "$src/config.yaml" ]; then
    cp "$src/config.yaml" "$tpl"
    rm -f "$src/config.yaml"
  fi

  # 1b. Same trick for the CLI, for a sharper reason: this script IS the one running. `cp` truncates
  #     its destination in place, so a bulk copy over $LMWEBUI_HOME/lmwebui would rewrite the very
  #     file bash is reading commands from, mid-execution — at best it survives on read-ahead
  #     buffering, at worst bash executes whatever the new bytes happen to line up with. Staging it
  #     aside and installing it with `mv` afterwards renames it onto a NEW inode, so the running
  #     shell keeps reading the old file while the path serves the new one.
  local staged_cli=""
  if [ -f "$src/lmwebui" ]; then
    staged_cli="$LMWEBUI_HOME/.lmwebui.new.$$"
    cp "$src/lmwebui" "$staged_cli"
    rm -f "$src/lmwebui"
  fi

  # 2. Ownership first, or cp/rm cannot write over root-owned leftovers from an old sudo run.
  if [ -n "$(find "$LMWEBUI_HOME/app" "$LMWEBUI_HOME/web" ! -user "$(whoami)" 2>/dev/null | head -1)" ]; then
    echo "   Fixing ownership (stale non-user files)..."
    chown -R "$(whoami)" "$LMWEBUI_HOME" 2>/dev/null || \
    sudo chown -R "$(whoami)" "$LMWEBUI_HOME" 2>/dev/null || {
      echo "❌ Could not fix ownership. Run: sudo chown -R $(whoami) $LMWEBUI_HOME"; exit 1; }
  fi

  # 3. Replace web/ wholesale, not just web/dist: a tarball ships no web/src, so a leftover
  #    web/src or web/vite.config.ts from a git-clone install would linger forever. The three
  #    clone-only top-level entries are the one-shot clone -> tarball migration.
  rm -rf "$LMWEBUI_HOME/app" "$LMWEBUI_HOME/web"
  for p in .git backend scripts; do rm -rf "$LMWEBUI_HOME/$p" 2>/dev/null || true; done

  cp -r "$src/." "$LMWEBUI_HOME/"

  # Install the new CLI last, by rename (see 1b). Same directory, so this is an atomic mv and the
  # destination gets a fresh inode rather than being truncated under the running shell.
  if [ -n "$staged_cli" ]; then
    mv -f "$staged_cli" "$LMWEBUI_HOME/lmwebui"
    chmod +x "$LMWEBUI_HOME/lmwebui"
  fi

  __apply_config_template
}

__apply_config_template() {
  # Consume $LMWEBUI_HOME/config.yaml.template: repair, create, or migrate the live config.
  local cfg="$LMWEBUI_HOME/config.yaml" tpl="$LMWEBUI_HOME/config.yaml.template"
  [ -f "$tpl" ] || return 0

  # Repair a clobber the OLD update left behind. It copied the tarball's config.yaml raw, so that
  # file still contains the un-substituted literal `~/.lmwebui` — a string a real install never
  # retains, because config creation always seds it to the actual home. -F: the dot is literal.
  if [ -f "$cfg.bak" ] && grep -qF '~/.lmwebui' "$cfg" 2>/dev/null; then
    echo "   Restoring config.yaml from config.yaml.bak (a previous update had replaced it)"
    cp "$cfg.bak" "$cfg"
  fi

  if [ ! -f "$cfg" ]; then
    sed "s|~/.lmwebui|$LMWEBUI_HOME|g" "$tpl" > "$cfg.new" && mv "$cfg.new" "$cfg"
    echo "   config.yaml created from the release template"
  elif grep -q "app_config\|port: 8000\|llm_config" "$cfg" 2>/dev/null; then
    echo "   Detected old config format. Backing up to config.yaml.bak..."
    cp "$cfg" "$cfg.bak"
    sed "s|~/.lmwebui|$LMWEBUI_HOME|g" "$tpl" > "$cfg.new" && mv "$cfg.new" "$cfg"
    echo "   config.yaml upgraded from the release template"
  fi
  # Write-then-rename above: a truncated config.yaml is not recoverable. Both removals are only
  # reached on success, since set -e aborts the arm first.
  rm -f "$tpl" "$cfg.new"
}

__fetch_release() {
  # $1 = destination directory. A private function rather than a subcommand: install.sh is the
  # bootstrap and cannot call into the tarball it is fetching, so `update` is the only caller.
  local dest="${1:?__fetch_release needs a destination directory}"
  local tgz; tgz="$(mktemp)"
  curl -fsSL --retry 3 --retry-delay 2 -o "$tgz" \
    "https://github.com/lm-webui/lm-webui/releases/latest/download/lm-webui.tar.gz" \
    || { echo "❌ Release download failed"; rm -f "$tgz"; exit 1; }
  tar -tzf "$tgz" >/dev/null 2>&1 || { echo "❌ Downloaded archive is corrupt"; rm -f "$tgz"; exit 1; }
  mkdir -p "$dest" && tar -xzf "$tgz" -C "$dest" --strip-components=1
  # Fail before touching the install, not half-way through replacing it. Clean up $dest too:
  # `update` passes a mktemp -d, and this exit skips its `rm -rf "$TMP"`, so removing only the
  # tarball would leave a whole extracted tree behind on a corrupt archive.
  if [ ! -f "$dest/app/main.py" ] || [ ! -f "$dest/web/dist/index.html" ]; then
    echo "❌ Release archive is missing app/main.py or web/dist/index.html"
    rm -f "$tgz"; rm -rf "$dest"; exit 1
  fi
  rm -f "$tgz"
}

installed_version() {
  [ -f "$LMWEBUI_HOME/package.json" ] || return 0
  "$LMWEBUI_HOME/.venv/bin/python" - "$LMWEBUI_HOME/package.json" 2>/dev/null <<'PY' || true
import json, sys
try:
    print(json.load(open(sys.argv[1])).get("version", "unknown"))
except Exception:
    print("unknown")
PY
}

latest_version() {
  curl -fsSL --max-time 10 "https://api.github.com/repos/lm-webui/lm-webui/releases/latest" 2>/dev/null \
    | python3 -c 'import json,sys; print(json.load(sys.stdin).get("tag_name", "unknown").lstrip("v"))' 2>/dev/null || true
}

case "${1:-status}" in
  __install-tree)
    # Internal — install.sh publishes this script from the release tree and then calls this to lay
    # that tree down. Not for humans; no stability promise, and deliberately absent from `help`.
    __install_tree "${2:?usage: lm-webui __install-tree <release-tree>}"
    ;;

  rebuild)
    SRC="${2:-$(pwd)}"
    [ -f "$SRC/web/package.json" ] && [ -f "$SRC/backend/app/main.py" ] || {
      echo "❌ Usage: lm-webui rebuild [source-directory]"
      echo "   Expected web/package.json and backend/app/main.py"
      exit 1
    }
    command -v npm >/dev/null 2>&1 || { echo "❌ npm is required for rebuild"; exit 1; }
    echo "🔨 Rebuilding LM-WebUI from $SRC..."
    (cd "$SRC/web" && npm ci && npm run build)
    [ -f "$SRC/web/dist/index.html" ] || { echo "❌ Frontend build produced no web/dist/index.html"; exit 1; }

    BUILD_TREE="$(mktemp -d)"
    trap 'rm -rf "$BUILD_TREE"' EXIT
    mkdir -p "$BUILD_TREE/app" "$BUILD_TREE/web"
    cp -r "$SRC/backend/app/." "$BUILD_TREE/app/"
    cp -r "$SRC/web/dist" "$BUILD_TREE/web/dist"
    cp "$SRC/backend/requirements.txt" "$SRC/backend/requirements.lock" "$BUILD_TREE/"
    cp "$SRC/backend/config.yaml" "$BUILD_TREE/config.yaml"
    cp "$SRC/package.json" "$BUILD_TREE/package.json"
    cp "$SRC/scripts/lmwebui" "$BUILD_TREE/lmwebui"
    __install_tree "$BUILD_TREE"
    rm -rf "$BUILD_TREE"
    trap - EXIT
    echo "   Installing locked Python dependencies..."
    if command -v uv >/dev/null 2>&1; then
      export VIRTUAL_ENV="$LMWEBUI_HOME/.venv"
      [ -x "$LMWEBUI_HOME/.venv/bin/python" ] || uv venv "$LMWEBUI_HOME/.venv"
      uv pip install -r "$LMWEBUI_HOME/requirements.lock" --quiet
    else
      [ -x "$LMWEBUI_HOME/.venv/bin/python" ] || python3 -m venv "$LMWEBUI_HOME/.venv"
      "$LMWEBUI_HOME/.venv/bin/python" -m pip install -r "$LMWEBUI_HOME/requirements.lock" --quiet
    fi
    reinstall_service || true
    "$0" start
    echo "✅ Rebuild complete: LM-WebUI $(installed_version)"
    ;;

  start)
    case "$(uname)" in
      Linux)
        linux_service start
        ;;
      Darwin)
        launchctl unload "$HOME/Library/LaunchAgents/com.lmwebui.server.plist" 2>/dev/null || true
        sleep 1
        launchctl load "$HOME/Library/LaunchAgents/com.lmwebui.server.plist" 2>/dev/null || echo "Failed to start"
        ;;
    esac
    # Wait (bounded) so the URL printed below is one that is actually answering. Test for
    # "ready":true, not just a 200 — the health route answers as soon as the app is up, while it
    # is still loading config, so a bare 200 made `start` report "Starting up…" on a service that
    # was healthy a second later. install.sh uses the same readiness check.
    tries=0
    while [ "$tries" -lt 30 ] && ! curl -sf --max-time 5 "$API/api/health" 2>/dev/null | grep -q '"ready":true'; do
      tries=$((tries + 1))
      sleep 1
    done
    if ! curl -sf --max-time 5 "$API/api/health" 2>/dev/null | grep -q '"ready":true'; then
      echo "❌ Service did not become ready within 30 seconds"
      diagnose
      exit 1
    fi
    # `"$0" status`, like every other re-invocation here. A bare `status` is not a function —
    # `status)` is a case pattern — so this died with "command not found" (exit 127) and `start`
    # never printed the health summary or the URL it exists to print. `update` calls
    # `"$0" start || true`, which swallowed the 127 and still reported success.
    "$0" status
    ;;

  stop)
    case "$(uname)" in
      Linux)
        linux_service stop
        ;;
      Darwin)
        launchctl unload "$HOME/Library/LaunchAgents/com.lmwebui.server.plist" 2>/dev/null || echo "Service not running"
        ;;
    esac
    ;;

  restart)
    "$0" stop || true
    sleep 2
    "$0" start || true
    ;;

  status)
    echo "Checking LM-WebUI at $LOCAL_URL ..."
    body="$(curl -sf --max-time 5 "$API/api/health" 2>/dev/null)" || true
    if [ -z "$body" ]; then
      # No HTTP at all: this is where the useful diagnostics live.
      echo "❌ Service is not reachable at $LOCAL_URL"
      diagnose
    else
      printf '%s' "$body" | python3 -c "
import sys, json
try:
    d = json.load(sys.stdin)
    s = d.get('status', 'unknown')
    print(f'Status: {s}')
    if d.get('ready'):
        print('✅ Service is healthy')
    elif s == 'error':
        print('❌ Service error:', d.get('message', ''))
        if d.get('error'):
            print('   Reason:', d['error'])
    else:
        print('⏳ Starting up...')
except Exception:
    print('❌ Reachable, but the health response did not parse')
" 2>/dev/null || true
      first_run_notice
    fi
    show_url
    echo "Data directory: $LMWEBUI_HOME/data/"
    ;;

  open)
    # The browser is on this machine, so localhost is the right target (lan_ip() can pick a
    # VPN/VirtualBox address). show_url below covers the open-it-from-another-device case.
    if command -v open >/dev/null 2>&1; then
      open "$LOCAL_URL"
    elif command -v xdg-open >/dev/null 2>&1; then
      xdg-open "$LOCAL_URL"
    else
      echo "No browser launcher here — open $LOCAL_URL"
    fi
    ;;

  logs)
    case "$(uname)" in
      Linux)
        journalctl -u lmwebui -f 2>/dev/null || echo "Try: sudo journalctl -u lmwebui -f"
        ;;
      Darwin)
        # uvicorn and logging.basicConfig() both write to stderr, so stdout.log alone shows
        # nothing useful on a failure.
        mkdir -p "$LMWEBUI_HOME/logs"
        tail -f "$LMWEBUI_HOME/logs/stdout.log" "$LMWEBUI_HOME/logs/stderr.log" 2>/dev/null || echo "No logs yet"
        ;;
    esac
    ;;

  update)
    echo "🔄 Updating LM-WebUI..."
    echo "   Data at $LMWEBUI_HOME/data/ will be preserved."
    echo ""

    # Resolve and authenticate the service manager before stopping anything. Falling back from a
    # system service to a user service is how Linux updates can leave the old process running.
    sudo -v 2>/dev/null || true
    detect_linux_service_scope

    # Stop the app first so files aren't locked during replace/build
    "$0" stop
    sleep 1
    if linux_service is-active --quiet; then
      echo "❌ LM-WebUI service is still active after stop; refusing to update" >&2
      exit 1
    fi

    # If anything fails after this point, bring the (old) service back up so a
    # bad update never leaves the app offline.
    TMP=""
    BACKUP=""
    _restart_on_fail() {
      local code=$?
      if [ -n "$BACKUP" ] && [ -d "$BACKUP" ]; then
        echo "⚠️ Update failed — restoring previous application tree."
        rm -rf "$LMWEBUI_HOME/app" "$LMWEBUI_HOME/web"
        mv "$BACKUP/app" "$LMWEBUI_HOME/app" 2>/dev/null || true
        mv "$BACKUP/web" "$LMWEBUI_HOME/web" 2>/dev/null || true
      fi
      rm -rf "$TMP" "$BACKUP"
      echo "⚠️ Update failed — restarting previous service."
      "$0" start || true
      exit "$code"
    }
    trap '_restart_on_fail' ERR

    # Fetch the release, then hand it to the same routine install.sh uses. Ownership repair, the
    # stale clone-layout cleanup and the config.yaml guard all live in there — this used to be a
    # second copy, and that is exactly how it came to clobber config.yaml while install.sh did not.
    TMP="$(mktemp -d)"
    echo "   Downloading latest release..."
    BEFORE_VERSION="$(installed_version)"
    TARGET_VERSION="$(latest_version)"
    [ -n "$TARGET_VERSION" ] && echo "   Installed: $BEFORE_VERSION · Latest: $TARGET_VERSION"
    __fetch_release "$TMP"
    echo "   Installing release tree (config.yaml preserved)..."
    BACKUP="$(mktemp -d)"
    mv "$LMWEBUI_HOME/app" "$BACKUP/app"
    mv "$LMWEBUI_HOME/web" "$BACKUP/web"
    __install_tree "$TMP"
    rm -rf "$TMP"

    # Update Python deps (including new ones added in update)
    if [ ! -x "$LMWEBUI_HOME/.venv/bin/python" ]; then
      if command -v uv &>/dev/null; then
        uv venv "$LMWEBUI_HOME/.venv" --python 3.12 2>/dev/null || uv venv "$LMWEBUI_HOME/.venv"
      else
        python3 -m venv "$LMWEBUI_HOME/.venv"
      fi
    fi
    if command -v uv &>/dev/null; then
      export VIRTUAL_ENV="$LMWEBUI_HOME/.venv"
      uv pip install -r "$LMWEBUI_HOME/requirements.lock" --quiet
    else
      "$LMWEBUI_HOME/.venv/bin/python" -m pip install --upgrade pip --quiet
      "$LMWEBUI_HOME/.venv/bin/python" -m pip install -r "$LMWEBUI_HOME/requirements.lock" --quiet
    fi

    # Runtime ensure — Vision (llama-server), GGUF binaries, MLX (Apple), service unit.
    echo "   Ensuring GGUF runtime (llama-server)..."
    ensure_llama_server || true
    check_gguf_runtime || true
    ensure_mlx || true
    echo "   Refreshing service unit..."
    reinstall_service

    # Frontend ships prebuilt in the tarball (web/dist) — no npm build needed.
    "$0" start
    if [ -n "$TARGET_VERSION" ] && [ "$TARGET_VERSION" != "unknown" ]; then
      RUNNING_VERSION="$(curl -sf --max-time 5 "$API/api/health" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("version", "unknown"))')"
      [ "$RUNNING_VERSION" = "$TARGET_VERSION" ] || {
        echo "❌ Running backend version $RUNNING_VERSION does not match release $TARGET_VERSION" >&2
        exit 1
      }
    fi
    rm -rf "$BACKUP"
    BACKUP=""
    trap - ERR
    echo ""
    echo "✅ LM-WebUI updated successfully."
    echo "   Installed version: $(installed_version)"
    echo "   Data preserved at $LMWEBUI_HOME/data/"
    echo "   Models at $LMWEBUI_HOME/models/"
    ;;

  runtime)
    echo "GGUF / Vision runtime:"
    check_gguf_runtime || true
    ;;

  version)
    curl -sf --max-time 5 "$API/api/health" 2>/dev/null | python3 -c "
import sys, json
try:
    d = json.load(sys.stdin)
    print('LM-WebUI', d.get('version', 'unknown'))
except Exception:
    print('unknown (service not reachable)')
" 2>/dev/null || echo "unknown (service not reachable)"
    ;;

  help|--help|-h)
    echo "Usage: lm-webui <command>"
    echo ""
    echo "Commands:"
    echo "  start     Start the LM-WebUI service"
    echo "  stop      Stop the LM-WebUI service"
    echo "  restart   Restart the LM-WebUI service"
    echo "  status    Show service health, the dashboard URL to open"
    echo "  open      Open the dashboard in your browser"
    echo "  logs      Follow service logs"
    echo "  runtime   Show GGUF/llama-server/Vision runtime health"
    echo "  version   Show the installed version"
    echo "  update    Update code from GitHub, preserve data"
    echo "  rebuild   Build and install from a local source checkout"
    echo ""
    echo "Environment:"
    echo "  LMWEBUI_HOME  Data directory (default: ~/.lmwebui)"
    ;;

  *)
    echo "Unknown command: $1"
    echo "Usage: lm-webui <start|stop|restart|status|open|logs|runtime|version|update|rebuild> [source-directory]"
    exit 1
    ;;
esac
