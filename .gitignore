# Desktop (Tauri) build artifacts — Rust target dir is large; Cargo.lock IS committed
desktop/src-tauri/target/
desktop/src-tauri/gen/schemas/
# Environment Var
# Wildcard rather than one line per mode: a bare web/.env is loaded by Vite in EVERY mode,
# so an unnamed mode file used to slip through unnoticed.
web/.env*
!web/.env.example
backend/.env
!backend/.env.example
secrets/
.secrets/
.dev
# App Data & Models
backend/data/*
!backend/data/.keep
backend/models/*
!backend/models/.keep
backend/app/files/*
backend/media/generated/*
backend/media/uploads/*
*.db
*.sqlite
*.sqlite3
# IDEs
.vscode/
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo
# Logs
logs/
*.log
# Agents
.claude/
.agents/
AGENTS.md
